# LLM Provider: dashscope | openai | anthropic | ollama (default: dashscope)
LLM_PROVIDER=dashscope

# API Keys (provider-dependent)
# dashscope: DASHSCOPE_API_KEY (required)
# openai:    OPENAI_API_KEY (required)
# anthropic: ANTHROPIC_API_KEY (required, uses the native Messages API)
# ollama:    not required
# LLM_API_KEY works as a generic override for any provider.
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# LLM Configuration (optional, provider presets used when empty)
# LLM_MODEL=qwen-plus
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_TIMEOUT_MS=120000

# Completion cap (output tokens). This is NOT the context window.
# LLM_MAX_TOKENS=2048
# Context window advertised by the model (input tokens). The usable history
# budget is LLM_CONTEXT_TOKENS * LLM_CONTEXT_SAFETY minus the completion
# reserve and tool schemas; history beyond it is trimmed oldest-first.
# LLM_CONTEXT_TOKENS=131072
# LLM_CONTEXT_SAFETY=0.85
# Per-tool-result cap; oversized outputs should go through artifacts.
# MAX_TOOL_RESULT_CHARS=16384
# Absolute prompt+completion budget for one run (0 = unlimited). Exhaustion is
# a hard failure: the request is rejected, never queued.
# MAX_RUN_TOKENS=0

# Retry / backoff for LLM calls (rate limit, timeout, network, 5xx)
# LLM_MAX_RETRIES=2
# LLM_RETRY_BASE_MS=500

# RAG Service (Phase 8+, optional)
RAG_API_URL=http://localhost:8000

# Agent Configuration (optional)
MAX_ITERATIONS=10
# Concurrent delegate_task sub-agents (bounds TPM pressure on large windows).
# MAX_PARALLEL_SUBAGENTS=2
LOG_LEVEL=info
# TOOL_TIMEOUT_MS=30000
# Require y/N confirmation for dangerous tools (outside file tools): off | on
# TOOL_APPROVAL=off
# Ask permission before file tools access each path: on (default) | off
# Once / session grants are exact paths; manage them with /permissions.
# PATH_APPROVAL=on
# Optional sandbox: confine file tools beneath this root (empty = disabled)
# WORKSPACE_ROOT=

# Session Persistence (Phase 12+, optional)
# SESSION_DB_PATH=.sessions.db

# Sandbox (M6 investigation agent, optional; used with --sandbox / npm run investigate)
# SANDBOX_PROVIDER=            # default provider when --sandbox is omitted
# SANDBOX_IMAGE=node:20-bookworm-slim
# SANDBOX_NETWORK=off          # on only for networked installs (no network by default)
# SANDBOX_CPU=2
# SANDBOX_MEMORY=2g
# SANDBOX_TIMEOUT_MS=600000

# MCP Servers (Phase 17+, optional)
# JSON array. Use "command"/"args" for stdio servers, or "url" for SSE servers.
# MCP_SERVERS=[{"name":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]
